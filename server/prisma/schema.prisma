generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

enum QAxis {
  SKILL
  WILL
}

enum Archetype {
  DELEGATE
  COACH
  INSPIRE_SUPPORT
  TELL
}

model Admin {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean      @default(false)
  role         AdminRole    @default(ADMIN)
  createdAt    DateTime     @default(now())
  createdById  String?
  assessments  Assessment[] @relation("AssessmentTakenBy")
}

model Employee {
  id          String       @id @default(cuid())
  fullName    String
  email       String?      @unique
  position    String
  department  String
  startDate   DateTime?
  photoPath   String?
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assessments Assessment[]

  @@index([department])
  @@index([archivedAt])
}

model Question {
  id       String  @id @default(cuid())
  text     String
  axis     QAxis
  reversed Boolean @default(false)
  weight   Float   @default(1)
  order    Int     @default(0)
  active   Boolean @default(true)

  @@index([axis, active, order])
}

model Assessment {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  takenAt    DateTime  @default(now())
  takenById  String
  takenBy    Admin     @relation("AssessmentTakenBy", fields: [takenById], references: [id])
  skillScore Float
  willScore  Float
  archetype  Archetype
  rawAnswers Json
  aiPlan     String?
  notes      String?

  @@index([employeeId, takenAt])
}

// connect-pg-simple's session table is created manually in prisma/seed.ts
// because it requires specific column types (varchar, json, timestamp(6))
// that don't map cleanly through Prisma's type system.
