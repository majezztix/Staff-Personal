# Copy to .env (server reads it from project root via dotenv)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_cards

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-32+-random-bytes

# Server
PORT=3000
UPLOAD_DIR=./uploads
NODE_ENV=development

# Initial superadmin (used on first seed only — change after first login)
INITIAL_ADMIN_USERNAME=Admin
INITIAL_ADMIN_PASSWORD=$TASAdmin$

# Anthropic (optional — AI dev plans disabled if not set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Scoring
SCORE_THRESHOLD=50

# 2FA
TOTP_ISSUER=TAS Employee Cards
# Set to "true" to bypass 2FA at login (for dev/internal use). Set to "false" or remove to enforce.
DISABLE_2FA=false

# Client (Vite)
VITE_API_BASE=http://localhost:3000
